{
  "manifest_version": 3,
  "name": "Telegram Lote · Descargas por tema",
  "version": "2.5.0",
  "description": "Descargas por bloques del tema abierto, cola recuperable, favoritos, vistas previas y ZIP64 por partes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "scripting",
    "downloads",
    "storage",
    "notifications",
    "unlimitedStorage",
    "downloads.open"
  ],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Telegram Lote",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
